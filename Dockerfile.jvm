## Using npm start for dev; for production, we'd use a multi-stage build with Nginx
#CMD ["npm", "run", "dev", "--", "--host"]

# Step 1: Build stage
FROM node:20-alpine AS builder
WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci

# Copy code and compile Vite static files
COPY . .
# Pass build-time env variables
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# Step 2: Serve stage with NGINX
FROM nginx:alpine
# Copy compiled output to NGINX standard directory
COPY --from=builder /app/build /usr/share/nginx/html

# Stage 2: Serve with NGINX
FROM nginx:alpine
# Copy built static files
COPY --from=build /app/dist /usr/share/nginx/html

# 🚀 Copy your custom NGINX configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose HTTP port
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]