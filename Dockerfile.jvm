# Step 1: Build stage (named 'builder')
FROM node:20-alpine AS builder
WORKDIR /app

# Install dependencies cleanly
COPY package*.json ./
RUN npm ci

# Copy source code
COPY . .

# Pass build-time env variables
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Build static output (outputs to /app/dist for Vite)
RUN npm run build

# Step 2: Serve stage with NGINX
FROM nginx:alpine

# Copy compiled static files from the 'builder' stage above
# (Change /app/dist to /app/build if your framework outputs to build/)
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom NGINX configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose HTTP port
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]