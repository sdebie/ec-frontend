# ─────────────────────────────────────────────────────────────
# EC Platform — environment variable reference
#
# Copy this file to .env.local for local overrides.
# .env.local is git-ignored and safe for secrets and dev-specific values.
# Do not copy sensitive values into .env — that file is committed to git.
# ─────────────────────────────────────────────────────────────

# ── API ──────────────────────────────────────────────────────

# Base path for all REST API calls (Axios baseURL for both HTTP clients).
# Default: /api — only change if the backend context root changes.
VITE_API_BASE_URL=/api

# Backend URL the Vite proxy forwards to during development.
# Default: http://localhost:8080
# Override in .env.local if you run the backend on a different port.
VITE_PROXY_TARGET=http://localhost:8080

# ── Mock API ─────────────────────────────────────────────────

# Enables the dev-only mock plugin that intercepts /api/* and /graphql with fixtures.
# true  → uses fixtures, backend not required (default for local dev)
# false → passes through to the real backend at VITE_PROXY_TARGET
# Note: the admin portal has no mock handlers regardless of this setting.
VITE_USE_MOCK_API=true

# ── Auth ─────────────────────────────────────────────────────

# Google OAuth client ID for customer Google Sign-In.
# Obtain from Google Cloud Console → APIs & Services → Credentials.
# Leave blank to disable Google Sign-In in development.
# Required in production — set as a deploy-time environment variable.
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# ── Admin Portal Branding ────────────────────────────────────

# Client name displayed in the admin header.
# Default: Admin Portal
VITE_CLIENT_NAME=UVH Holdings

# Tagline displayed below the client name in the admin header.
# Default: Management Console
VITE_CLIENT_TAGLINE=Management Console

# ─────────────────────────────────────────────────────────────
# ORPHANED — not yet consumed. Uncomment when the feature is built.
# ─────────────────────────────────────────────────────────────

# Tenant/store slug for this client deployment.
# VITE_STORE_FRONT=uvh

# Base URL for images served from backend static storage.
# VITE_IMAGE_BASE_URL=/static/images/

# REST Countries API key for checkout address country selector.
# Get your key at https://restcountries.com — do not commit a live key.
# VITE_REST_COUNTRIES_API_KEY=your-key-here
