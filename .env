# ─────────────────────────────────────────────────────────────
# EC Platform — Frontend environment variables
#
# This file is committed to git. It contains safe defaults only.
# Never put secrets or per-developer overrides here.
# For local overrides, create .env.local (git-ignored).
# ─────────────────────────────────────────────────────────────

# ── API ──────────────────────────────────────────────────────

# Base path for all REST API calls.
# Consumed by adminHttpClient and storefrontHttpClient as their Axios baseURL.
# The Vite dev server proxies requests matching this prefix to VITE_PROXY_TARGET.
# Leave as /api unless the backend changes its context root.
VITE_API_BASE_URL=/api

# Backend URL that the Vite dev-server proxy forwards /api and /graphql requests to.
# Only applies during `vite dev` — has no effect in production builds.
# Override in .env.local if your backend runs on a different port or host.
VITE_PROXY_TARGET=http://localhost:8080

# ── Mock API ─────────────────────────────────────────────────

# Controls whether the Vite dev-only mock plugin (devApiPlugin) is loaded.
# true  → all /api/* and /graphql requests are intercepted and served from fixtures.
#         Use this when the backend is not running locally.
# false → requests pass through the Vite proxy to the real backend (VITE_PROXY_TARGET).
#         Requires: mvn quarkus:dev running, DB seeded via ec-infra/scripts/seed-uvh.sql
# Note: the admin portal has no mock handlers — it always requires the real backend.
VITE_USE_MOCK_API=false

# ── Auth ─────────────────────────────────────────────────────

# Google OAuth client ID for customer Google Sign-In.
# Consumed by AppProviders → GoogleOAuthProvider.
# Obtain from Google Cloud Console → APIs & Services → Credentials.
# Safe to leave blank in development if Google Sign-In is not being tested.
# In production this value must be set as a deploy-time environment variable.
VITE_GOOGLE_CLIENT_ID=

# ─────────────────────────────────────────────────────────────
# ORPHANED — not yet consumed by the rewrite frontend.
# Kept here as placeholders until the features that need them are built.
# ─────────────────────────────────────────────────────────────

# Tenant/store slug used to identify this client deployment.
# Will be consumed once multi-tenant StorefrontConfig loading is wired in.
# VITE_STORE_FRONT=uvh

# Base URL for product and variant images served from backend static storage.
# IMAGE_STORAGE_PATH=storage/ is served at /static/images/*.
# Image paths from the API are relative to storage/ (e.g. 'images/01/foo.png'),
# so they are appended directly to this base — no stripping.
VITE_IMAGE_BASE_URL=/static/images/

# REST Countries API key (https://restcountries.com) for country/region dropdowns.
# Will be consumed once the checkout address form country selector is built.
# Override in .env.local with your own key — do not commit a live key to this file.
# VITE_REST_COUNTRIES_API_KEY=
